
@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap');

:root {
    --ungu: #7651a8;
    --ungu-muda: #a98bd0;
    --pink: #e987a9;
    --peach: #f2b36d;
    --cream: #fff9f1;
    --putih: #ffffff;
    --teks: #39334d;
    --abu: #777184;
    --bayangan: 0 8px 25px rgba(80, 55, 110, 0.12);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--cream);
    color: var(--teks);
    line-height: 1.7;
}

button {
    font-family: inherit;
    cursor: pointer;
    border: none;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: 90%;
    max-width: 1150px;
    margin: auto;
}

section {
    padding: 75px 0;
}

h1, h2, h3 {
    font-family: 'Baloo 2', cursive;
    line-height: 1.2;
}

h2 {
    color: var(--ungu);
    font-size: 2.3rem;
    text-align: center;
    margin-bottom: 15px;
}

.section-desc {
    text-align: center;
    color: var(--abu);
    max-width: 650px;
    margin: 0 auto 35px;
}

/* NAVBAR */

.navbar {
    background: var(--putih);
    padding: 15px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.logo {
    color: var(--ungu);
    font-family: 'Baloo 2', cursive;
    font-size: 1.5rem;
    font-weight: 800;
}

.nav-links {
    display: flex;
    gap: 22px;
    list-style: none;
    align-items: center;
}

.nav-links a {
    font-size: 0.85rem;
    font-weight: 600;
    transition: 0.3s;
}

.nav-links a:hover {
    color: var(--pink);
}

/* BERANDA */

.hero {
    min-height: 550px;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #7651a8, #bd83b5, #e987a9);
    color: white;
    padding: 60px 0;
    overflow: hidden;
}

.hero-content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 35px;
}

.hero h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 20px;
}

.hero p {
    font-size: 1rem;
    margin-bottom: 25px;
    max-width: 550px;
}

.hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
}

.hero-image svg {
    width: 100%;
    max-width: 380px;
    filter: drop-shadow(0 15px 20px rgba(0,0,0,0.15));
}

.btn {
    display: inline-block;
    background: white;
    color: var(--ungu);
    padding: 12px 25px;
    border-radius: 30px;
    font-weight: 700;
    transition: 0.3s;
}

.btn:hover {
    transform: translateY(-4px);
    box-shadow: var(--bayangan);
}

/* KARTU INFORMASI */

.intro {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 35px;
}

.fakta, .card, .study-card {
    background: white;
    padding: 25px;
    border-radius: 20px;
    box-shadow: var(--bayangan);
    transition: 0.3s;
}

.fakta:hover, .card:hover, .study-card:hover {
    transform: translateY(-6px);
}

.fakta h3, .card h3 {
    color: var(--ungu);
    margin-bottom: 10px;
}

/* LAPISAN BUMI */

.layers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 35px;
}

.layer {
    background: white;
    padding: 25px 18px;
    border-radius: 20px;
    box-shadow: var(--bayangan);
    text-align: center;
    transition: 0.3s;
}

.layer:hover {
    transform: translateY(-8px);
}

.layer h3 {
    margin: 15px 0 8px;
    color: var(--ungu);
}

.layer p {
    font-size: 0.9rem;
    color: var(--abu);
}

.layer-visual {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin: auto;
    border: 9px solid rgba(255,255,255,0.7);
    box-shadow: 0 5px 15px rgba(0,0,0,0.12);
}

/* JELAJAH LEBIH DALAM */

.study-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 25px;
    align-items: start;
}

.tabs {
    display: grid;
    gap: 12px;
}

.tab-btn {
    padding: 15px;
    background: white;
    color: var(--teks);
    border-radius: 14px;
    text-align: left;
    font-weight: 700;
    box-shadow: var(--bayangan);
    transition: 0.3s;
}

.tab-btn:hover,
.tab-btn.active {
    background: var(--ungu);
    color: white;
}

.tab-panel {
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: var(--bayangan);
    min-height: 230px;
}

.tab-panel h3 {
    color: var(--ungu);
    font-size: 1.5rem;
    margin-bottom: 12px;
}

/* KARTU PINTAR */

.flashcard-area {
    max-width: 600px;
    margin: auto;
    text-align: center;
}

.flashcard {
    min-height: 250px;
    background: linear-gradient(135deg, #7651a8, #e987a9);
    color: white;
    border-radius: 25px;
    padding: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    box-shadow: var(--bayangan);
    cursor: pointer;
    transition: 0.4s;
}

.flashcard:hover {
    transform: scale(1.02);
}

.flashcard h3 {
    font-size: 1.8rem;
    margin-bottom: 15px;
}

.flashcard p {
    font-size: 1rem;
}

.flashcard-controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
}

.small-btn {
    background: var(--ungu);
    color: white;
    padding: 10px 20px;
    border-radius: 25px;
    font-weight: 600;
    transition: 0.3s;
}

.small-btn:hover {
    background: var(--pink);
    transform: translateY(-3px);
}

/* KUIS */

.quiz-box {
    max-width: 750px;
    margin: auto;
    background: white;
    padding: 30px;
    border-radius: 22px;
    box-shadow: var(--bayangan);
}

.progress {
    height: 10px;
    background: #eee7f4;
    border-radius: 20px;
    overflow: hidden;
    margin: 15px 0 25px;
}

.progress-bar {
    height: 100%;
    width: 0%;
    background: var(--pink);
    border-radius: 20px;
    transition: 0.4s;
}

.answers {
    display: grid;
    gap: 12px;
    margin-top: 20px;
}

.answer-btn {
    background: #f7f2fb;
    color: var(--teks);
    padding: 14px 18px;
    border-radius: 13px;
    text-align: left;
    font-weight: 600;
    transition: 0.3s;
}

.answer-btn:hover {
    background: #eadcf7;
}

.answer-btn.correct {
    background: #d8f1df;
    color: #24643a;
}

.answer-btn.wrong {
    background: #ffe0e0;
    color: #9c3030;
}

.feedback {
    margin-top: 18px;
    font-weight: 700;
}

.quiz-controls {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

/* PERMAINAN URUTAN */

.game-area {
    background: white;
    max-width: 800px;
    margin: auto;
    padding: 30px;
    border-radius: 22px;
    box-shadow: var(--bayangan);
}

.piece-list, .drop-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 20px 0;
}

.piece, .drop-slot {
    padding: 15px;
    border-radius: 13px;
    text-align: center;
    font-weight: 700;
    border: 2px dashed var(--ungu-muda);
    background: #faf6ff;
    cursor: pointer;
    transition: 0.3s;
}

.piece:hover, .piece.selected {
    background: var(--ungu);
    color: white;
}

.drop-slot {
    min-height: 60px;
    background: #fff8f5;
}

.drop-slot.filled {
    border-style: solid;
    background: #f4e9fb;
}

/* PERMAINAN MENCOCOKKAN */

.match-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    max-width: 850px;
    margin: auto;
}

.match-column {
    display: grid;
    gap: 12px;
}

.match-option {
    background: white;
    padding: 18px;
    border-radius: 14px;
    box-shadow: var(--bayangan);
    cursor: pointer;
    border: 2px solid transparent;
    transition: 0.3s;
}

.match-option:hover,
.match-option.selected {
    border-color: var(--ungu);
    background: #f5effc;
}

.match-option.matched {
    background: #e0f3e4;
    border-color: #75b987;
    cursor: default;
}

.match-option.wrong {
    background: #ffe5e5;
    border-color: #e98787;
}

.hidden {
    display: none !important;
}

/* FOOTER */

footer {
    background: #49365f;
    color: white;
    text-align: center;
    padding: 30px 15px;
    margin-top: 50px;
}

footer p {
    font-size: 0.9rem;
}

/* RESPONSIVE UNTUK HP DAN TABLET */

@media (max-width: 900px) {
    .layers {
        grid-template-columns: repeat(2, 1fr);
    }

    .nav-links {
        gap: 12px;
    }

    .nav-links a {
        font-size: 0.75rem;
    }
}

@media (max-width: 700px) {
    section {
        padding: 55px 0;
    }

    .navbar {
        flex-direction: column;
        gap: 10px;
    }

    .nav-links {
        width: 100%;
        overflow-x: auto;
        padding: 5px 0;
        justify-content: flex-start;
    }

    .nav-links a {
        white-space: nowrap;
    }

    .hero {
        text-align: center;
        padding: 45px 0;
    }

    .hero-content {
        grid-template-columns: 1fr;
    }

    .hero-image svg {
        max-width: 260px;
    }

    .intro {
        grid-template-columns: 1fr;
    }

    .layers {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .layer {
        padding: 18px 12px;
    }

    .study-grid {
        grid-template-columns: 1fr;
    }

    .tabs {
        grid-template-columns: 1fr 1fr;
    }

    .tab-btn {
        font-size: 0.8rem;
        padding: 12px;
    }

    .match-grid {
        grid-template-columns: 1fr;
    }

    .quiz-box, .game-area {
        padding: 20px;
    }

    h2 {
        font-size: 1.9rem;
    }
}

@media (max-width: 400px) {
    .layers {
        grid-template-columns: 1fr;
    }

    .piece-list, .drop-list {
        grid-template-columns: 1fr;
    }

    .tabs {
        grid-template-columns: 1fr;
    }

    .flashcard {
        min-height: 220px;
        padding: 25px;
    }
}
